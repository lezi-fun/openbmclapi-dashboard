[Unit]
Description=OpenBMCLAPI Dashboard (Nginx log analytics)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/workspace/openbmclapi-dashboard
Environment=DASHBOARD_PORT=4001
Environment=NGINX_LOG_PATH=/www/wwwlogs/openbmclapi.log
Environment=GEO_MODE=nginx_geoip
ExecStart=/usr/bin/node /workspace/openbmclapi-dashboard/server.js
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
